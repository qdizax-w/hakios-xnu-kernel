#!/bin/sh
# GNU stat for xl on a Mac: MacPorts' gstat, else Homebrew's (or anyone's) gstat, else a GNU stat elsewhere on PATH
# (coreutils built into a prefix of one's own). Never this file again; and a clear word if there is none.
[ -x /opt/local/bin/gstat ] && exec /opt/local/bin/gstat "$@"
command -v gstat >/dev/null 2>&1 && exec gstat "$@"
here=$(cd "$(dirname "$0")" && pwd)
IFS=:
for d in $PATH; do
	[ "$d" = "$here" ] && continue
	[ -x "$d/stat" ] && "$d/stat" --version 2>/dev/null | grep -q 'GNU coreutils' && exec "$d/stat" "$@"
done
if [ "$1" = -c ]; then
	case "$2" in
	%s) shift 2; exec /usr/bin/stat -f %z "$@" ;;
	%Y) shift 2; exec /usr/bin/stat -f %m "$@" ;;
	esac
fi
exec /usr/bin/stat "$@"
